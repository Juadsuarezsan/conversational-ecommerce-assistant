# LLM (required for full functionality)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Embeddings — paid (recommended) or fall back to local sentence-transformers
VOYAGE_API_KEY=
EMBEDDING_BACKEND=local   # local | voyage

# Reranking — paid (recommended) or fall back to local cross-encoder
COHERE_API_KEY=
RERANK_BACKEND=local      # local | cohere

# Infrastructure
DATABASE_URL=postgresql://ecommerce:ecommerce_dev@localhost:5432/ecommerce
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Vector store selection for the agent (qdrant | pgvector | chroma)
VECTOR_STORE=qdrant

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
MAX_RETRIEVAL_K=20
RERANK_TOP_N=5
ESCALATION_REFUND_THRESHOLD_USD=100
