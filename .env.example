# ---------------------------------------------------------------------------
# LLM (optional). Without a key the API runs the deterministic fallback:
# keyword intent router + template synthesizer. Model is pinned to a dated id.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
LLM_TIMEOUT_SECONDS=15
LLM_PRICE_IN_PER_MTOK=3.0
LLM_PRICE_OUT_PER_MTOK=15.0

# ---------------------------------------------------------------------------
# Embeddings: hash (deterministic, no model) | local (needs `pip install -e ".[ml]"`) | voyage
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=hash
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Reranker: lexical (deterministic, no model) | local (needs `.[ml]`) | cohere
# ---------------------------------------------------------------------------
RERANK_BACKEND=lexical
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EXTERNAL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Storage. Defaults need no Docker; docker-compose.yml overrides them.
# ---------------------------------------------------------------------------
VECTOR_STORE=in_memory          # in_memory | qdrant | pgvector | chroma
CART_BACKEND=memory             # memory | postgres
SESSION_BACKEND=memory          # memory | redis
SESSION_TTL_SECONDS=1800
DATABASE_URL=postgresql://ecommerce:ecommerce_dev@localhost:5432/ecommerce
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./data/cache/chroma

# ---------------------------------------------------------------------------
# Retrieval / policy knobs
# ---------------------------------------------------------------------------
MAX_RETRIEVAL_K=20
RERANK_TOP_N=5
ESCALATION_REFUND_THRESHOLD_USD=100

# ---------------------------------------------------------------------------
# HTTP security: comma-separated origins (never *), slowapi rate limit
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
RATE_LIMIT=60/minute

# ---------------------------------------------------------------------------
# Observability (optional). LangSmith is enabled only when the key is set.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-assistant
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Streamlit front-end
API_URL=http://localhost:8000
